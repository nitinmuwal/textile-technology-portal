rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read access for all documents
    match /{document=**} {
      allow read: if true;
      // Write only for authenticated super admins
      allow write: if request.auth != null && 
        request.auth.token.email in ['nitinshab43@gmail.com'];  // ← Apne emails daalein
    }
  }
}